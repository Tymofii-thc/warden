{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "strict": false,
    "outDir": "dist",
    "rootDir": ".",
    "moduleResolution": "node",
    "declaration": true
  },
  "include": ["sdk/**/*.ts", "offchain/**/*.ts", "demo/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules", "dist", "target"]
}
